  {
   "name": "输入示例",
   "sample": "orderId:506683458994743225\norderEntryIds:[506683458996743225]\ndisputeRequest:returnRefund\napplyPayment:1\napplyCarriage:0\napplyReasonId:20028\ndescription:测试\ngoodsStatus:refundBuyerReceived\nvouchers:\norderEntryCountList:[{&quot;id&quot;:506683458996743225,&quot;count&quot;:1}]\n",
