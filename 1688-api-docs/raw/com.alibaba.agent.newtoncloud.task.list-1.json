   "type": "String",
   "required": true,
   "description": "请求签名",
   "exampleValue": null,
   "defaultValue": null,
   "complexTypeFlag": null,
   "typeName": null
  },
  {
   "name": "access_token",
   "type": "String",
   "required": true,
   "description": "用户授权令牌",
   "exampleValue": null,
