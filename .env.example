# Copy to .env for local runs.  `make dev` and `make up` both read it.

# ---- our backend -----------------------------------------------------------
# Set ENV=production and the process refuses to start while any credential below
# is still one of these development placeholders. Leave it as dev locally.
ENV=dev
API_ADDR=:8787
DATABASE_URL=postgres://app:app@localhost:5455/market?sslmode=disable
ADMIN_TOKEN=dev
PUBLIC_BASE=http://localhost:5173
# How often an open supplier order is refreshed from the gateway. 5m in
# production; seconds locally so the demo does not wait on the safety net.
POLL_INTERVAL=30s

# ---- the 1688 gateway ------------------------------------------------------
# Point ALI_BASE_URL at the stub now, at https://gw.open.1688.com when access lands.
ALI_BASE_URL=http://localhost:8788
ALI_APP_KEY=DEVKEY
ALI_APP_SECRET=devsecret
ALI_ACCESS_TOKEN=devtoken

# ---- the stub gateway ------------------------------------------------------
STUB_ADDR=:8788
STUB_BASE=http://localhost:8788
STUB_ACCESS_TOKEN=devtoken
STUB_APP_SECRET=devsecret
STUB_PRODUCTS=300
STUB_STATE_FILE=./.stub-state.json
DOCS_DIR=./1688-api-docs

# Where the stub pushes messages. Empty = queue only, drained via
# push.cursor.messageList — that is how the gap-fill path gets tested.
PUSH_URL=http://localhost:8787/api/hooks/1688

# Lifecycle clock. speed 1 = real delays, 20 = twenty times faster.
STUB_SPEED=20
STUB_AUTOPAY=0
STUB_DELAY_PAY=30s
STUB_DELAY_SHIP=60s
STUB_DELAY_STEP=20s
STUB_DELAY_SIGN=120s

# Deliberate hostility. All off by default.
STUB_CHAOS=0
STUB_PUSH_JITTER=0
STUB_CREATE_FLAT=0
STUB_SIGN=on
